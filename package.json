    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "ci:lint": "nx affected --target=lint --base=remotes/origin/master --parallel",
    "ci:build": "nx affected --target=build --base=remotes/origin/master --parallel --configuration production --with-deps",
    "ci:test": "nx affected --target=test --base=remotes/origin/master --parallel",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "migrate:latest": "nx migrate @nrwl/workspace@latest",
    "migrate:run": "nx migrate --run-migrations=migrations.json",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "ts2json": "ts-json-schema-generator",
    "json2ts": "json2ts",
    "webpack-bundle-analyzer": "webpack-bundle-analyzer",
    "workspace-generator": "nx workspace-generator",
    "postinstall": "node ./decorate-angular-cli.js && ngcc --properties es2015 browser module main"
