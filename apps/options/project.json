{
  "name": "options",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/options/src",
  "prefix": "plopdown",
  "tags": ["ext-dep"],
  "generators": {
    "@nx/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "",
      "options": {
        "outputPath": "dist/apps/plopdown-ext/options",
        "index": "apps/options/src/index.html",
        "main": "apps/options/src/main.ts",
        "polyfills": "apps/options/src/polyfills.ts",
        "tsConfig": "apps/options/tsconfig.app.json",
        "baseHref": "/options/index.html",
        "assets": ["apps/options/src/favicon.ico", "apps/options/src/assets"],
        "styles": ["apps/options/src/styles.scss"],
        "scripts": [],
        "allowedCommonJsDependencies": ["lz-string", "immediate"],
        "vendorChunk": true,
        "extractLicenses": false,
        "buildOptimizer": false,
        "sourceMap": true,
        "optimization": false,
        "namedChunks": true
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/options/src/environments/environment.ts",
              "with": "apps/options/src/environments/environment.prod.ts"
            }
          ],
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          },
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false,
          "buildOptimizer": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "continuous": true,
      "options": {
        "buildTarget": "options:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "options:build:production"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "options:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/options"],
      "options": {
        "jestConfig": "apps/options/jest.config.ts"
      }
    }
  }
}
