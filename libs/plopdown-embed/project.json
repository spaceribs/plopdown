{
  "name": "plopdown-embed",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/plopdown-embed/src",
  "prefix": "plopdown",
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "libs/plopdown-embed/jest.config.ts"
      },
      "outputs": ["{workspaceRoot}/coverage/libs/plopdown-embed"]
    }
  },
  "generators": {
    "@nx/angular:component": {
      "style": "scss"
    }
  },
  "tags": []
}
