{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "types": ["jest", "node", "firefox-webext-browser", "pouchdb-node"],
    "target": "es2016",
    "moduleResolution": "bundler",
    "isolatedModules": true
  },
  "files": ["src/test-setup.ts"],
  "include": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.mock.ts",
    "**/*.d.ts",
    "jest.config.ts"
  ]
}
